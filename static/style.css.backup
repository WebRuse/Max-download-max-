
/* =========================================
   WEBRUSE MAIN DESIGN
   ========================================= */

* {
    box-sizing: border-box;
}

html {
    min-height: 100%;
}

body {
    margin: 0;
    min-height: 100vh;
    font-family: Arial, Helvetica, sans-serif;
    color: #20252b;
    background: linear-gradient(
        180deg,
        #eef5ff 0%,
        #f7f9fc 45%,
        #ffffff 100%
    );
}

.topbar {
    width: 100%;
    background: #ffffff;
    border-bottom: 1px solid #dce3ec;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}

.topbar-inner {
    max-width: 1150px;
    margin: 0 auto;
    padding: 16px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
}

.logo {
    color: #1f2937;
    text-decoration: none;
    font-size: 26px;
    font-weight: 900;
    letter-spacing: -1px;
}

.nav {
    display: flex;
    align-items: center;
    gap: 22px;
}

.nav a {
    color: #4b5563;
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
}

.nav a:hover {
    color: #1677ff;
}

.main {
    max-width: 1150px;
    margin: 0 auto;
    padding: 45px 24px 70px;
}

.hero {
    background: linear-gradient(135deg, #ffffff 0%, #edf5ff 100%);
    border: 1px solid #dbe6f3;
    border-radius: 22px;
    padding: 55px 45px;
    margin-bottom: 30px;
    box-shadow: 0 10px 35px rgba(31,65,114,0.08);
}

.hero-content {
    max-width: 760px;
}

.hero-badge {
    display: inline-block;
    padding: 7px 13px;
    margin-bottom: 15px;
    border-radius: 999px;
    background: #e2efff;
    color: #1677ff;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1.5px;
}

.hero h1 {
    margin: 0 0 16px;
    font-size: 48px;
    line-height: 1.08;
    letter-spacing: -2px;
    color: #18212b;
}

.hero p {
    margin: 0;
    max-width: 700px;
    color: #657181;
    font-size: 18px;
    line-height: 1.7;
}

.hero-actions {
    display: flex;
    gap: 12px;
    margin-top: 28px;
    flex-wrap: wrap;
}

.button {
    display: inline-block;
    border: none;
    border-radius: 10px;
    padding: 12px 20px;
    font-size: 15px;
    font-weight: 800;
    text-decoration: none;
    cursor: pointer;
    transition: 0.2s;
}

.button:hover {
    transform: translateY(-2px);
}

.button-primary {
    color: white;
    background: #1677ff;
    box-shadow: 0 6px 16px rgba(22,119,255,0.22);
}

.button-primary:hover {
    background: #0867e6;
}

.button-secondary {
    color: #27313d;
    background: #e9eef5;
}

.button-secondary:hover {
    background: #dce3ec;
}

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.card {
    background: #ffffff;
    border: 1px solid #e0e6ee;
    border-radius: 18px;
    padding: 28px;
    box-shadow: 0 8px 25px rgba(30,50,80,0.06);
    transition: 0.2s;
}

.card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(30,50,80,0.10);
}

.card-icon {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
    border-radius: 14px;
    background: #edf5ff;
    font-size: 25px;
}

.card h2 {
    margin: 0 0 10px;
    color: #202934;
    font-size: 21px;
}

.card p {
    margin: 0 0 18px;
    color: #6b7582;
    line-height: 1.6;
}

.card-link {
    color: #1677ff;
    text-decoration: none;
    font-weight: 800;
}

.form-card {
    width: 100%;
    max-width: 500px;
    margin: 30px auto;
    padding: 38px;
    background: #ffffff;
    border: 1px solid #dfe6ef;
    border-radius: 20px;
    box-shadow: 0 12px 35px rgba(30,50,80,0.08);
}

.form-card h1 {
    margin-top: 0;
    margin-bottom: 10px;
}

.form-card > p {
    color: #697586;
    line-height: 1.6;
}

.form-card form {
    margin-top: 25px;
}

.form-card input {
    width: 100%;
    padding: 13px 14px;
    margin-bottom: 13px;
    border: 1px solid #d4dce7;
    border-radius: 9px;
    outline: none;
    font-size: 15px;
    background: #fbfcfe;
}

.form-card input:focus {
    border-color: #1677ff;
    box-shadow: 0 0 0 3px rgba(22,119,255,0.10);
}

.form-card .button {
    width: 100%;
}

.form-footer {
    margin-top: 22px;
    text-align: center;
}

.form-footer a {
    color: #1677ff;
    font-weight: 700;
}

.message {
    display: none;
    margin-top: 16px;
    padding: 12px 14px;
    border-radius: 9px;
    background: #eef5ff;
    color: #27598f;
    font-weight: 700;
}

.profile {
    max-width: 850px;
    margin: 0 auto;
    padding: 38px;
    background: #ffffff;
    border: 1px solid #dfe6ef;
    border-radius: 20px;
    box-shadow: 0 12px 35px rgba(30,50,80,0.08);
}

.profile h1 {
    margin: 0 0 8px;
    font-size: 36px;
}

.profile > p {
    color: #697586;
}

.stat {
    padding: 13px 15px;
    margin-top: 10px;
    border-radius: 10px;
    background: #f5f7fa;
    color: #4c5663;
}

.tix {
    display: inline-block;
    margin: 18px 0 12px;
    padding: 10px 15px;
    border-radius: 10px;
    background: #fff5c9;
    color: #8a6800;
    font-weight: 900;
}

.inventory-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
}

.item {
    padding: 25px;
    text-align: center;
    background: #ffffff;
    border: 1px solid #e0e6ee;
    border-radius: 16px;
    box-shadow: 0 7px 22px rgba(30,50,80,0.06);
}

.item-icon {
    font-size: 45px;
    margin-bottom: 12px;
}

.item strong {
    display: block;
    margin-bottom: 7px;
}

.item span {
    color: #77818e;
    font-size: 13px;
}

.footer {
    margin-top: 20px;
    padding: 25px 24px;
    border-top: 1px solid #dce3ec;
    background: #ffffff;
}

.footer-inner {
    max-width: 1150px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: #8993a0;
    font-size: 13px;
}

@media (max-width: 800px) {
    .topbar-inner {
        flex-direction: column;
        align-items: flex-start;
    }

    .nav {
        flex-wrap: wrap;
        gap: 12px;
    }

    .hero h1 {
        font-size: 36px;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    .inventory-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 600px) {
    .main {
        padding: 25px 15px 50px;
    }

    .hero {
        padding: 35px 25px;
    }

    .hero h1 {
        font-size: 30px;
    }

    .form-card {
        padding: 25px;
    }

    .inventory-grid {
        grid-template-columns: 1fr;
    }

    .footer-inner {
        flex-direction: column;
    }
}

/* =========================================
   WEBRUSE BLOCK AVATAR
   ========================================= */

.avatar-character {
    width: 150px;
    height: 230px;
    margin: 0 auto;
    position: relative;
}


/* ---------- HEAD ---------- */

.avatar-character .avatar-head {
    width: 70px;
    height: 70px;
    position: absolute;
    top: 0;
    left: 40px;

    background: #f2c49b;
    border: 4px solid #222;
    border-radius: 7px;

    z-index: 3;
}


/* ---------- BODY ---------- */

.avatar-arms {
    position: absolute;
    top: 73px;
    left: 15px;

    width: 120px;
    height: 80px;

    display: flex;
    align-items: stretch;
    justify-content: center;
}


.avatar-arm {
    width: 25px;
    height: 75px;

    background: #777;
    border: 4px solid #222;

    border-radius: 5px;
}


.avatar-torso {
    width: 65px;
    height: 75px;

    background: #777;
    border: 4px solid #222;

    margin: 0 3px;

    border-radius: 6px;
}


/* ---------- LEGS ---------- */

.avatar-legs {
    position: absolute;
    top: 148px;
    left: 40px;

    width: 70px;
    height: 78px;

    display: flex;
    gap: 5px;
}


.avatar-leg {
    width: 32px;
    height: 75px;

    background: #303744;
    border: 4px solid #222;

    border-radius: 5px;
}


/* ---------- BODY COLORS ---------- */

.avatar-default .avatar-arm,
.avatar-default .avatar-torso {
    background: #777;
}

.avatar-red .avatar-arm,
.avatar-red .avatar-torso {
    background: #d94343;
}

.avatar-blue .avatar-arm,
.avatar-blue .avatar-torso {
    background: #4287d6;
}

.avatar-green .avatar-arm,
.avatar-green .avatar-torso {
    background: #45a85a;
}

.avatar-yellow .avatar-arm,
.avatar-yellow .avatar-torso {
    background: #e4b83d;
}


/* ---------- MINI AVATAR ---------- */

.mini-avatar {
    width: 70px;
    height: 105px;
    margin: 0 auto 8px;
    position: relative;
}


.mini-head {
    width: 32px;
    height: 32px;

    position: absolute;
    top: 0;
    left: 19px;

    background: #f2c49b;
    border: 2px solid #222;

    border-radius: 4px;
}


.mini-body-row {
    position: absolute;
    top: 33px;
    left: 7px;

    width: 56px;
    height: 38px;

    display: flex;
    align-items: stretch;
    justify-content: center;
}


.mini-arm {
    width: 11px;
    height: 38px;

    background: #777;
    border: 2px solid #222;

    border-radius: 3px;
}


.mini-body {
    width: 30px;
    height: 38px;

    background: #777;
    border: 2px solid #222;

    border-radius: 3px;

    margin: 0 2px;
}


.mini-legs {
    position: absolute;
    top: 70px;
    left: 19px;

    display: flex;
    gap: 2px;
}


.mini-leg {
    width: 14px;
    height: 32px;

    background: #303744;
    border: 2px solid #222;

    border-radius: 3px;
}


/* ---------- MINI COLORS ---------- */

.avatar-default .mini-arm,
.avatar-default .mini-body {
    background: #777;
}

.avatar-red .mini-arm,
.avatar-red .mini-body {
    background: #d94343;
}

.avatar-blue .mini-arm,
.avatar-blue .mini-body {
    background: #4287d6;
}

.avatar-green .mini-arm,
.avatar-green .mini-body {
    background: #45a85a;
}

.avatar-yellow .mini-arm,
.avatar-yellow .mini-body {
    background: #e4b83d;
}


/* ---------- PROFILE AVATAR ---------- */

.profile .avatar-preview {
    width: 170px;
    height: 245px;

    margin: 30px auto;

    display: flex;
    justify-content: center;
    align-items: flex-start;
}


.avatar-preview .avatar-character {
    transform: scale(1);
    transform-origin: top center;
}


/* ---------- HOVER ---------- */

.avatar-option:hover .mini-avatar {
    transform: scale(1.05);
}

.mini-avatar {
    transition: 0.2s;
}


/* ---------- MOBILE ---------- */

@media (max-width: 600px) {

    .avatar-character {
        transform: scale(0.9);
        transform-origin: top center;
    }

}


/* =========================================================
   WEBRUSE 3D AVATAR EDITOR
   ========================================================= */

.avatar-editor {
    max-width: 1100px;
    margin: 0 auto;
}

.avatar-editor-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
}

.avatar-editor-header h1 {
    margin: 0;
    font-size: 36px;
}

.avatar-editor-header p {
    margin: 6px 0 0;
    color: #777;
}

.avatar-editor-layout {
    display: grid;
    grid-template-columns: minmax(420px, 1fr) 430px;
    gap: 22px;
}

.avatar-stage {
    background: linear-gradient(
        145deg,
        #eeeeee,
        #d9d9d9
    );

    border: 1px solid #c8c8c8;
    border-radius: 8px;
    padding: 18px;
    min-height: 650px;
}

.stage-label {
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
    color: #777;
    margin-bottom: 8px;
}

.avatar-3d-scene {
    height: 510px;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    perspective: 1000px;
    cursor: grab;
    user-select: none;
    overflow: hidden;
}

.avatar-3d-scene.dragging {
    cursor: grabbing;
}

.avatar-3d {
    --avatar-width: 1;
    --avatar-height: 1;

    position: relative;
    width: 210px;
    height: 390px;

    transform-style: preserve-3d;

    transform:
        rotateX(-8deg)
        rotateY(-25deg);

    transition:
        transform 0.15s ease;

    z-index: 5;
}

.avatar-3d-head {
    position: absolute;

    width: 125px;
    height: 125px;

    left: 42px;
    top: 10px;

    background: #f0c6a0;

    border: 3px solid #222;

    border-radius: 8px;

    transform-style: preserve-3d;

    box-shadow:
        10px 10px 0 rgba(0,0,0,0.15);
}

.avatar-3d-head::before {
    content: "";

    position: absolute;

    width: 125px;
    height: 125px;

    background: inherit;

    border: 3px solid #222;

    top: -3px;
    left: 22px;

    transform:
        translateZ(-22px)
        rotateY(90deg);

    opacity: 0.9;
}

.avatar-3d-head::after {
    content: "";

    position: absolute;

    width: 125px;
    height: 125px;

    background: #d9a77f;

    border: 3px solid #222;

    top: 22px;
    left: 0;

    transform:
        translateZ(-22px)
        rotateX(90deg);

    opacity: 0.9;
}

.face {
    position: absolute;
    inset: 0;
    transform: translateZ(4px);
}

.eye {
    position: absolute;

    width: 13px;
    height: 18px;

    background: #111;

    border-radius: 50%;

    top: 48px;
}

.eye.left {
    left: 34px;
}

.eye.right {
    right: 34px;
}

.mouth {
    position: absolute;

    width: 42px;
    height: 10px;

    border-bottom: 4px solid #111;

    border-radius: 50%;

    left: 40px;
    top: 78px;
}

.avatar-3d-body {
    position: absolute;

    top: 145px;
    left: 15px;

    width: 180px;
    height: 150px;

    transform-style: preserve-3d;
}

.avatar-3d-torso {
    position: absolute;

    left: 35px;
    top: 0;

    width: 110px;
    height: 150px;

    background: #2d72d9;

    border: 3px solid #222;

    transform-style: preserve-3d;

    display: flex;
    align-items: center;
    justify-content: center;

    font-weight: 900;
    color: white;

    font-size: 24px;
}

.avatar-3d-torso::after {
    content: "";

    position: absolute;

    width: 110px;
    height: 150px;

    background: #2256a7;

    border: 3px solid #222;

    left: 20px;

    transform:
        translateZ(-20px)
        rotateY(90deg);
}

.avatar-3d-arm {
    position: absolute;

    width: 45px;
    height: 145px;

    top: 3px;

    background: #f0c6a0;

    border: 3px solid #222;

    transform-style: preserve-3d;
}

.left-arm {
    left: -15px;
}

.right-arm {
    right: -15px;
}

.avatar-3d-legs {
    position: absolute;

    top: 295px;
    left: 42px;

    width: 125px;
    height: 120px;

    display: flex;
    gap: 7px;

    transform-style: preserve-3d;
}

.avatar-3d-leg {
    width: 59px;
    height: 120px;

    background: #333;

    border: 3px solid #222;

    transform-style: preserve-3d;
}

.avatar-platform {
    position: absolute;

    width: 270px;
    height: 75px;

    background: #c7c7c7;

    border: 2px solid #aaa;

    border-radius: 50%;

    bottom: 30px;

    transform:
        rotateX(72deg);

    box-shadow:
        0 25px 30px rgba(0,0,0,0.2);
}

.avatar-controls {
    display: flex;
    justify-content: center;
    gap: 8px;
}

.avatar-controls button {
    min-width: 70px;
}

.drag-hint {
    text-align: center;
    color: #777;
    font-size: 13px;
    margin-bottom: 0;
}

.avatar-sidebar {
    background: white;

    border: 1px solid #d2d2d2;
    border-radius: 8px;

    overflow: hidden;

    min-height: 650px;
}

.editor-tabs {
    display: flex;

    border-bottom: 1px solid #ddd;

    overflow-x: auto;
}

.editor-tabs button {
    background: white;
    color: #222;

    border-radius: 0;

    padding: 15px 13px;

    white-space: nowrap;
}

.editor-tabs button.active {
    color: #1475d1;

    border-bottom: 3px solid #1475d1;
}

.editor-section {
    padding: 20px;

    border-bottom: 1px solid #eee;
}

.editor-section h2 {
    margin-top: 0;
    margin-bottom: 5px;
}

.editor-section p {
    color: #777;
}

.avatar-color-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 10px;
}

.color-choice {
    background: white;
    color: #222;

    border: 2px solid #ddd;

    padding: 8px;

    transition:
        transform 0.15s,
        border-color 0.15s;
}

.color-choice:hover {
    background: #fafafa;
    transform: translateY(-2px);
}

.color-choice.selected {
    border-color: #16a85b;

    box-shadow:
        0 0 0 2px rgba(22,168,91,0.15);
}

.color-preview {
    height: 90px;

    position: relative;

    display: flex;
    flex-direction: column;

    align-items: center;

    justify-content: center;
}

.mini-3d-head {
    width: 32px;
    height: 32px;

    background: #f0c6a0;

    border: 2px solid #222;

    border-radius: 4px;
}

.mini-3d-body {
    width: 50px;
    height: 35px;

    margin-top: 2px;

    background: #2d72d9;

    border: 2px solid #222;
}

.mini-3d-legs {
    width: 45px;
    height: 22px;

    margin-top: 2px;

    background: #333;

    border: 2px solid #222;
}

.avatar-red .avatar-3d-torso,
.avatar-red .mini-3d-body {
    background: #d94141;
}

.avatar-blue .avatar-3d-torso,
.avatar-blue .mini-3d-body {
    background: #367bd6;
}

.avatar-green .avatar-3d-torso,
.avatar-green .mini-3d-body {
    background: #38a85a;
}

.avatar-yellow .avatar-3d-torso,
.avatar-yellow .mini-3d-body {
    background: #e2b52f;
}

.avatar-default .avatar-3d-torso,
.avatar-default .mini-3d-body {
    background: #777;
}

.scale-row {
    margin-top: 18px;
}

.scale-row > div {
    display: flex;
    justify-content: space-between;

    margin-bottom: 7px;
}

.scale-row input {
    width: 100%;
    margin: 0;
    padding: 0;
}

@media (max-width: 850px) {

    .avatar-editor-layout {
        grid-template-columns: 1fr;
    }

}

@media (max-width: 600px) {

    .avatar-editor-header {
        align-items: flex-start;
        gap: 10px;
    }

    .avatar-editor-header h1 {
        font-size: 28px;
    }

    .avatar-stage {
        min-height: 550px;
    }

    .avatar-3d-scene {
        height: 420px;
    }

    .avatar-sidebar {
        min-height: auto;
    }

}

/* =========================================
   WEBRUSE INVENTORY
   ========================================= */

.inventory-page {
    max-width: 1100px;
    margin: 0 auto;
}

.inventory-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 25px;
}

.inventory-header h1 {
    margin-bottom: 5px;
}

.inventory-header p {
    margin: 0;
    opacity: 0.7;
}

.inventory-balance {
    padding: 12px 18px;
    background: #fff;
    border: 1px solid #d5dce5;
    border-radius: 8px;
    font-weight: bold;
    box-shadow: 0 2px 6px rgba(0,0,0,0.08);
}

.inventory-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 22px;
    padding-bottom: 12px;
    border-bottom: 1px solid #d5dce5;
}

.inventory-tab {
    padding: 9px 18px;
    border: 1px solid #cbd3dd;
    border-radius: 6px;
    background: #fff;
    cursor: pointer;
    font-weight: 600;
}

.inventory-tab:hover {
    background: #eef5fc;
}

.inventory-tab.active {
    background: #3f82c4;
    color: white;
    border-color: #3f82c4;
}

.inventory-grid {
    display: grid;
    grid-template-columns: repeat(
        auto-fill,
        minmax(210px, 1fr)
    );
    gap: 18px;
}

.inventory-card {
    min-height: 280px;
    display: flex;
    flex-direction: column;
    padding: 15px;
    background: #fff;
    border: 1px solid #d5dce5;
    border-radius: 9px;
    box-shadow: 0 3px 10px rgba(0,0,0,0.08);
    transition:
        transform 0.15s ease,
        box-shadow 0.15s ease;
}

.inventory-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 7px 18px rgba(0,0,0,0.13);
}

.inventory-preview {
    height: 170px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #eef4f9;
    border-radius: 7px;
    font-size: 72px;
    margin-bottom: 14px;
}

.inventory-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 14px;
}

.inventory-info strong {
    font-size: 17px;
}

.inventory-info span {
    font-size: 13px;
    color: #737b86;
}

.inventory-equip {
    width: 100%;
    margin-top: auto;
    padding: 10px;
    border: 0;
    border-radius: 6px;
    background: #3f82c4;
    color: white;
    font-weight: bold;
    cursor: pointer;
}

.inventory-equip:hover {
    background: #326fa9;
}

.inventory-card.empty {
    opacity: 0.65;
}

@media (max-width: 650px) {

    .inventory-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .inventory-grid {
        grid-template-columns: 1fr 1fr;
    }

}

@media (max-width: 420px) {

    .inventory-grid {
        grid-template-columns: 1fr;
    }

}

```css
/* =========================================
   WEBRUSE PUBLIC PROFILE
   ========================================= */

.public-profile {
    max-width: 900px;
    margin: 40px auto;
}

.public-profile-card {
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 35px;
    background: #ffffff;
    border: 1px solid #d5dce5;
    border-radius: 12px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
}

.public-avatar {
    width: 220px;
    height: 220px;

    display: flex;
    justify-content: center;
    align-items: center;

    background: #eef4f9;
    border-radius: 12px;
}

.public-avatar-head {
    position: relative;

    width: 120px;
    height: 120px;

    background: #f2c29b;
    border-radius: 8px;

    box-shadow:
        inset 0 -8px 0 rgba(0, 0, 0, 0.08),
        0 5px 12px rgba(0, 0, 0, 0.15);
}

/* Skin colors */

.public-avatar-head.avatar-red {
    background: #d98b72;
}

.public-avatar-head.avatar-blue {
    background: #8fb9d9;
}

.public-avatar-head.avatar-green {
    background: #9bc98f;
}

.public-avatar-head.avatar-yellow {
    background: #f0d477;
}

/* Face */

.avatar-eye {
    position: absolute;

    width: 12px;
    height: 18px;

    top: 38px;

    background: #111111;
    border-radius: 3px;
}

.avatar-eye.left {
    left: 30px;
}

.avatar-eye.right {
    right: 30px;
}

.public-avatar-head::after {
    content: "";

    position: absolute;

    width: 38px;
    height: 18px;

    left: 50%;
    bottom: 24px;

    transform: translateX(-50%);

    border-bottom: 4px solid #111111;
    border-radius: 50%;
}

.public-profile-info {
    flex: 1;
}

.public-profile-info h1 {
    margin: 0 0 4px 0;
    font-size: 34px;
}

.player-id {
    margin: 0 0 25px 0;
    color: #737b86;
}

.public-profile-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 25px;
}

.profile-stat {
    min-width: 120px;
    padding: 14px;

    background: #f5f7fa;
    border: 1px solid #dce2e8;
    border-radius: 8px;
}

.profile-stat strong {
    display: block;
    font-size: 18px;
    margin-bottom: 4px;
}

.profile-stat span {
    font-size: 13px;
    color: #737b86;
}

.profile-action {
    display: inline-block;

    padding: 11px 20px;

    border: 0;
    border-radius: 7px;

    background: #3f82c4;
    color: white;

    font-weight: bold;
    text-decoration: none;
    cursor: pointer;
}

.profile-action:hover {
    background: #326fa9;
}

@media (max-width: 650px) {

    .public-profile {
        margin: 20px auto;
    }

    .public-profile-card {
        flex-direction: column;
        text-align: center;
        padding: 25px;
    }

    .public-profile-stats {
        justify-content: center;
    }

}

/* =========================================
   WEBRUSE PLAYER PROFILE
   ========================================= */

.player-page {
    max-width: 950px;
    margin: 25px auto 50px;
}

/* ---------- HEADER ---------- */

.player-header {
    display: flex;
    align-items: center;
    gap: 22px;

    padding: 18px 20px;

    background: #ffffff;
    border: 1px solid #cfd5dc;
    border-radius: 4px;

    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
}

.player-avatar-box {
    width: 105px;
    height: 105px;

    display: flex;
    justify-content: center;
    align-items: center;

    background: #e8edf2;
    border: 1px solid #c8d0d8;
    border-radius: 4px;
}

.player-avatar {
    position: relative;

    width: 78px;
    height: 78px;

    background: #f2c29b;
    border-radius: 5px;

    box-shadow:
        inset 0 -6px 0 rgba(0, 0, 0, 0.08),
        0 3px 8px rgba(0, 0, 0, 0.15);
}

.player-avatar.avatar-red {
    background: #d98b72;
}

.player-avatar.avatar-blue {
    background: #8fb9d9;
}

.player-avatar.avatar-green {
    background: #9bc98f;
}

.player-avatar.avatar-yellow {
    background: #f0d477;
}

.avatar-eye {
    position: absolute;

    top: 25px;

    width: 9px;
    height: 13px;

    background: #111;
    border-radius: 2px;
}

.avatar-eye.left {
    left: 19px;
}

.avatar-eye.right {
    right: 19px;
}

.player-header-info {
    flex: 1;
}

.player-name-row {
    display: flex;
    align-items: center;
    gap: 8px;
}

.player-name-row h1 {
    margin: 0;

    font-size: 27px;
    font-weight: 600;
}

.player-badge {
    padding: 2px 6px;

    background: #e7f1fb;
    border: 1px solid #b9d2e9;

    color: #3575ad;

    font-size: 10px;
    font-weight: bold;

    border-radius: 3px;
}

.player-id {
    margin-top: 3px;

    color: #7b858f;
    font-size: 13px;
}

.player-status {
    margin-top: 5px;

    color: #3a9b57;
    font-size: 12px;
}

.player-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;

    margin-top: 14px;
}

.player-stats div {
    display: flex;
    flex-direction: column;
}

.player-stats span {
    color: #89919a;
    font-size: 11px;
}

.player-stats strong {
    color: #3f82c4;
    font-size: 14px;
    font-weight: 600;
}

.player-actions {
    align-self: flex-start;
}

.player-button {
    display: inline-block;

    padding: 8px 13px;

    background: #168de2;
    border: 1px solid #0878c5;
    border-radius: 3px;

    color: white;

    font-size: 12px;
    font-weight: bold;

    text-decoration: none;
    cursor: pointer;
}

.player-button:hover {
    background: #087bc9;
}


/* ---------- TABS ---------- */

.profile-tabs {
    display: flex;

    margin-top: 10px;

    background: #ffffff;
    border: 1px solid #cfd5dc;
}

.profile-tab {
    flex: 1;

    padding: 9px 12px;

    background: #ffffff;
    border: 0;
    border-right: 1px solid #d9dee3;

    color: #4c5965;

    font-size: 12px;

    cursor: pointer;
}

.profile-tab:last-child {
    border-right: 0;
}

.profile-tab:hover {
    background: #f4f7f9;
}

.profile-tab.active {
    color: #197fc3;

    box-shadow: inset 0 -2px 0 #168de2;
}


/* ---------- SECTIONS ---------- */

.profile-section {
    margin-top: 13px;
}

.profile-section h2 {
    margin: 0 0 5px;

    color: #3f4d59;

    font-size: 17px;
    font-weight: 500;
}

.profile-panel {
    background: #ffffff;
    border: 1px solid #cfd5dc;
}


/* ---------- ABOUT ---------- */

.about-panel {
    min-height: 75px;
}

.about-text {
    margin: 0;
    padding: 13px;

    color: #737d87;
    font-size: 12px;
}

.about-footer {
    padding: 7px 13px;

    border-top: 1px solid #e0e4e8;

    color: #8b949d;
    font-size: 10px;
}


/* ---------- SECTION TITLE ---------- */

.section-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.section-link,
.small-blue-button {
    padding: 5px 10px;

    background: #168de2;
    border: 1px solid #0878c5;
    border-radius: 3px;

    color: white;

    font-size: 10px;
    text-decoration: none;

    cursor: pointer;
}

.section-link:hover,
.small-blue-button:hover {
    background: #087bc9;
}


/* ---------- WEARING ---------- */

.wearing-panel {
    display: flex;
    min-height: 250px;
}

.wearing-avatar {
    flex: 1;

    min-height: 250px;

    display: flex;
    justify-content: center;
    align-items: center;

    background: #f5f6f7;
    border-right: 1px solid #d6dce1;
}

.big-avatar {
    position: relative;

    width: 125px;
    height: 125px;

    background: #f2c29b;
    border-radius: 7px;

    box-shadow:
        inset 0 -10px 0 rgba(0, 0, 0, 0.08),
        0 5px 14px rgba(0, 0, 0, 0.16);
}

.big-avatar.avatar-red {
    background: #d98b72;
}

.big-avatar.avatar-blue {
    background: #8fb9d9;
}

.big-avatar.avatar-green {
    background: #9bc98f;
}

.big-avatar.avatar-yellow {
    background: #f0d477;
}

.big-eye {
    position: absolute;

    top: 40px;

    width: 14px;
    height: 19px;

    background: #111;

    border-radius: 3px;
}

.big-eye.left {
    left: 32px;
}

.big-eye.right {
    right: 32px;
}

.big-smile {
    position: absolute;

    width: 40px;
    height: 18px;

    left: 50%;
    bottom: 25px;

    transform: translateX(-50%);

    border-bottom: 4px solid #111;
    border-radius: 50%;
}

.wearing-items {
    width: 42%;

    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 7px;

    padding: 12px;

    background: #3d7798;
}

.wearing-item {
    min-height: 90px;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    background: #ffffff;
    border: 1px solid #c8d0d6;
    border-radius: 3px;

    font-size: 27px;
}

.wearing-item span {
    margin-top: 5px;

    color: #596570;
    font-size: 9px;

    text-align: center;
}

.wearing-item.empty {
    color: #a7afb7;
}


/* ---------- FRIENDS ---------- */

.friends-panel {
    min-height: 75px;

    display: flex;
    align-items: center;
}

.empty-profile-message {
    width: 100%;

    padding: 22px;

    color: #7b858e;

    font-size: 12px;
    text-align: center;
}


/* ---------- COLLECTIONS ---------- */

.collection-panel {
    display: flex;
    gap: 10px;

    padding: 12px;

    overflow-x: auto;
}

.collection-item {
    width: 105px;
    min-width: 105px;

    text-align: center;
}

.collection-icon {
    height: 90px;

    display: flex;
    justify-content: center;
    align-items: center;

    background: #f4f6f8;
    border: 1px solid #cfd5dc;

    font-size: 38px;
}

.collection-item span {
    display: block;

    margin-top: 5px;

    color: #397db7;

    font-size: 10px;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}


/* ---------- GAMES ---------- */

.games-panel {
    padding: 12px;
}

.game-card {
    width: 220px;

    border: 1px solid #ccd3da;
    background: #f7f8f9;
}

.game-thumbnail {
    height: 115px;

    display: flex;
    justify-content: center;
    align-items: center;

    background: #dce4ea;

    font-size: 45px;
}

.game-info {
    padding: 9px;
}

.game-info strong {
    display: block;

    color: #3f82c4;
    font-size: 12px;
}

.game-info span {
    display: block;

    margin-top: 3px;

    color: #89929b;
    font-size: 10px;
}


/* ---------- EMPTY PANELS ---------- */

.empty-panel,
.favorites-panel {
    min-height: 75px;

    display: flex;
    align-items: center;
}


/* ---------- MOBILE ---------- */

@media (max-width: 700px) {

    .player-page {
        margin: 15px 10px 40px;
    }

    .player-header {
        flex-wrap: wrap;
    }

    .player-actions {
        width: 100%;
    }

    .player-button {
        width: 100%;
        text-align: center;
        box-sizing: border-box;
    }

    .player-stats {
        gap: 14px;
    }

    .wearing-panel {
        flex-direction: column;
    }

    .wearing-avatar {
        border-right: 0;
        border-bottom: 1px solid #d6dce1;
    }

    .wearing-items {
        width: auto;
    }

}
